{
  "entities": {
    "UserSave": {
      "title": "UserSave",
      "description": "Private manager progression, currency balances, VIP points, competitive ranking telemetry, pack counts, milestone claims, and admin moderation metadata.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owning manager.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "managerName": {
          "type": "string",
          "description": "Display name of the FC Online manager (HLV).",
          "minLength": 2,
          "maxLength": 32
        },
        "deviceLabel": {
          "type": "string",
          "description": "Non-PII platform/device label.",
          "minLength": 2,
          "maxLength": 40
        },
        "fc": {
          "type": "integer",
          "description": "FC premium currency balance."
        },
        "bp": {
          "type": "number",
          "description": "BP transfer market currency balance."
        },
        "starPoints": {
          "type": "integer",
          "description": "Star Point (Tarpoi / Điểm Sao) currency balance for Shop Tarpoi."
        },
        "nextCardSerial": {
          "type": "integer",
          "description": "Next sequential card serial counter (#0001+) for INFINITY_PRIME and LE seasons."
        },
        "vipPoints": {
          "type": "integer",
          "description": "Cumulative VIP points earned from SVIP progression."
        },
        "vipLevel": {
          "type": "integer",
          "description": "Calculated VIP tier from 0 to 20."
        },
        "foosballLoops": {
          "type": "integer",
          "description": "Available Bi Lac event loops counter (bounded 0..1000000)."
        },
        "foosballSpins": {
          "type": "integer",
          "description": "Cumulative Bi Lac event points/spins counter toward milestone 10000."
        },
        "foosballJackpotFc": {
          "type": "integer",
          "description": "Progressive Jackpot pot from 100 FC to 1000000 FC."
        },
        "squadValue": {
          "type": "number",
          "description": "Total squad value in BP."
        },
        "bestCardOvr": {
          "type": "integer",
          "description": "Highest effective OVR among owned player cards."
        },
        "bestCardName": {
          "type": "string",
          "description": "Name of the highest OVR player card.",
          "minLength": 1,
          "maxLength": 60
        },
        "bestCardSeason": {
          "type": "string",
          "description": "Season code of the highest OVR card.",
          "minLength": 1,
          "maxLength": 16
        },
        "bestCardGrade": {
          "type": "integer",
          "description": "Enhancement grade (+1 to +13) of the highest OVR card."
        },
        "elo": {
          "type": "integer",
          "description": "Official Ranked 1vs1 / GLXH rating points (1000 to 10000)."
        },
        "wins": {
          "type": "integer",
          "description": "Cumulative competitive match wins."
        },
        "draws": {
          "type": "integer",
          "description": "Cumulative competitive match draws."
        },
        "losses": {
          "type": "integer",
          "description": "Cumulative competitive match losses."
        },
        "managerXp": {
          "type": "integer",
          "description": "Cumulative Manager XP used to compute Manager Level 1..100."
        },
        "squadOvr": {
          "type": "integer",
          "description": "Starting XI boosted overall rating (0 to 300)."
        },
        "claimedBroadcastIds": {
          "type": "array",
          "description": "Bounded list (max 50) of claimed global server broadcast gift IDs."
        },
        "packs": {
          "type": "object",
          "description": "Bounded map of pack template IDs to integer quantities."
        },
        "claimedMilestones": {
          "type": "array",
          "description": "Bounded list of claimed Bi Lac spin milestone thresholds."
        },
        "claimedVipRewards": {
          "type": "array",
          "description": "Bounded list of claimed VIP level reward tiers."
        },
        "formation": {
          "type": "string",
          "description": "Selected tactical formation code (22 official FC Online formations).",
          "minLength": 5,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9\\-]+$"
        },
        "activeTeamColorId": {
          "type": "string",
          "description": "Selected primary Team Color identifier or auto.",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lineupSlotUids": {
          "type": "array",
          "description": "Bounded list (max 11) of card UIDs placed in starting lineup tactical slots."
        },
        "isBanned": {
          "type": "boolean",
          "description": "Admin-enforced account suspension flag."
        },
        "banReason": {
          "type": "string",
          "description": "Optional suspension reason set by Administrator.",
          "minLength": 0,
          "maxLength": 100
        },
        "isDelegatedAdmin": {
          "type": "boolean",
          "description": "Admin-delegated game control privilege flag."
        },
        "adminRevision": {
          "type": "integer",
          "description": "Monotonic revision counter incremented on Administrator account edits."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "managerName",
        "fc",
        "bp",
        "vipPoints",
        "vipLevel",
        "foosballLoops",
        "foosballSpins",
        "foosballJackpotFc",
        "squadValue",
        "bestCardOvr",
        "bestCardName",
        "bestCardSeason",
        "bestCardGrade",
        "packs",
        "claimedMilestones",
        "claimedVipRewards",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlayerCardDoc": {
      "title": "PlayerCardDoc",
      "description": "Individual player card owned by a manager in their club inventory.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the card owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "templateId": {
          "type": "string",
          "description": "Static player card template identifier.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grade": {
          "type": "integer",
          "description": "Enhancement grade from 1 to 13."
        },
        "ovr": {
          "type": "integer",
          "description": "Effective overall rating of the card."
        },
        "valueBp": {
          "type": "number",
          "description": "Current BP valuation of the card."
        },
        "customMinifaceUrl": {
          "type": "string",
          "description": "Optional Locker Room equipped background-free miniface asset path or custom mobile portrait Data URL.",
          "minLength": 14,
          "maxLength": 160000,
          "pattern": "^(/minifaces/[a-zA-Z0-9_\\-]+\\.png|data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+)$"
        },
        "serialNumber": {
          "type": "integer",
          "description": "Optional sequential pull serial number (#0001+) strictly for INFINITY_PRIME and LE cards."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "templateId",
        "grade",
        "ovr",
        "valueBp",
        "createdAt",
        "updatedAt"
      ]
    },
