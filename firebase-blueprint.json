    "ServerRulesDoc": {
      "title": "ServerRulesDoc",
      "description": "Global server gameplay rules controlled exclusively by the Administrator game account for all players across devices and webs.",
      "type": "object",
      "properties": {
        "configId": {
          "type": "string",
          "description": "Singleton config document key ('global_rules').",
          "enum": ["global_rules"],
          "minLength": 12,
          "maxLength": 12
        },
        "guaranteedUpgrade100": {
          "type": "boolean",
          "description": "Whether card enhancement succeeds at 100% across the server."
        },
        "upgradeRateMultiplier": {
          "type": "number",
          "description": "Server enhancement rate multiplier (1, 1.5, 2, or 3)."
        },
        "zeroMarketTax": {
          "type": "boolean",
          "description": "Whether transfer market sales have 0% tax across the server."
        },
        "matchRewardMultiplier": {
          "type": "integer",
          "description": "Server match BP & Tarpoi reward multiplier (1, 2, or 3)."
        },
        "serverAnnouncement": {
          "type": "string",
          "description": "Live announcement banner displayed to all players in the Lobby.",
          "minLength": 0,
          "maxLength": 140
        },
        "updatedBy": {
          "type": "string",
          "description": "Display name of the Administrator who updated the rules.",
          "minLength": 2,
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "configId",
        "guaranteedUpgrade100",
        "upgradeRateMultiplier",
        "zeroMarketTax",
        "matchRewardMultiplier",
        "serverAnnouncement",
        "updatedBy",
        "updatedAt"
      ]
    },
    "ServerBroadcastDoc": {
      "title": "ServerBroadcastDoc",
      "description": "Immutable server-wide reward broadcast issued by the Administrator game account for all players across devices and webs.",
      "type": "object",
      "properties": {
        "broadcastId": {
          "type": "string",
          "description": "Unique broadcast gift identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scope": {
          "type": "string",
          "description": "Public broadcast partition key.",
          "enum": ["GLOBAL"],
          "minLength": 6,
          "maxLength": 6
        },
        "actorName": {
          "type": "string",
          "description": "Administrator display name.",
          "minLength": 2,
          "maxLength": 32
        },
        "fcDelta": {
          "type": "integer",
          "description": "FC gifted to every player."
        },
        "bpDelta": {
          "type": "number",
          "description": "BP gifted to every player."
        },
        "tarpoiDelta": {
          "type": "integer",
          "description": "Star Points (Tarpoi) gifted to every player."
        },
        "svipBonusPoints": {
          "type": "integer",
          "description": "Bonus VIP points gifted to every player."
        },
        "packId": {
          "type": "string",
          "description": "Season pack ID gifted to every player.",
          "minLength": 2,
          "maxLength": 24
        },
        "packCount": {
          "type": "integer",
          "description": "Quantity of packs gifted to every player."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "broadcastId",
        "scope",
        "actorName",
        "fcDelta",
        "bpDelta",
        "tarpoiDelta",
        "svipBonusPoints",
        "packId",
        "packCount",
        "createdAt"
      ]
    },
    "AdminRoleDoc": {
      "title": "AdminRoleDoc",
      "description": "Trusted administrator allowlist document keyed by Firebase Auth UID and managed strictly by the root bootstrapped Administrator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the delegated administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when admin privilege was provisioned."
        }
      },
      "required": ["uid", "grantedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserSave" },
      "description": "Private per-manager game progression state (accessible to owner or verified GM Admin)."
    },
    "/users/{userId}/cards/{cardId}": {
      "schema": { "$ref": "PlayerCardDoc" },
      "description": "Manager-owned player card subcollection (accessible to owner or verified GM Admin)."
    },
    "/cloud_managed_accounts/{accountId}": {
      "schema": { "$ref": "CloudManagedAccountDoc" },
      "description": "Cross-web and cross-device non-PII game account state writable strictly by verified GM Admins and readable by target game clients."
    },
    "/cloud_managed_accounts/{accountId}/cards/{cardId}": {
      "schema": { "$ref": "CloudManagedCardDoc" },
      "description": "Player card subcollection for cross-web managed game accounts."
    },
    "/leaderboard_entries/{userId}": {
      "schema": { "$ref": "LeaderboardEntry" },
      "description": "Public non-PII multi-category leaderboard entries queried by boardScope == GLOBAL."
    },
    "/server_config/{configId}": {
      "schema": { "$ref": "ServerRulesDoc" },
      "description": "Global server gameplay rules readable by all players and writable strictly by verified Admins."
    },
    "/server_broadcasts/{broadcastId}": {
      "schema": { "$ref": "ServerBroadcastDoc" },
      "description": "Immutable server-wide reward broadcasts readable by all players (scope == GLOBAL) and created strictly by verified Admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "AdminRoleDoc" },
      "description": "Trusted delegated administrator registry managed exclusively by the root bootstrapped GM Admin."
    }
  }
}
